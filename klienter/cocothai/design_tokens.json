    "glass": {
      "surface": "rgba(17, 30, 26, 0.82)",
      "scrolled": "rgba(14, 24, 22, 0.94)",
      "solid": "#121c19",
      "selectedSolid": "#29493a",
      "edge": "rgba(245, 237, 224, 0.18)",
      "highlight": "rgba(245, 237, 224, 0.32)",
      "radius": "9999px",
      "blur": "14px",
      "feedback": "140ms",
      "motion": "220ms",
      "easing": "cubic-bezier(0.33, 1, 0.68, 1)",
      "lens": {
        "mobileDiameter": "40px",
        "desktopDiameter": "88px",
        "magnification": 1.45,
        "mobileMaxDisplacement": "3px",
        "desktopMaxDisplacement": "6px"
      }
    }
